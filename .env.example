# ---------------------------------------------------------------------------
# Supabase > Project Settings > API
# ---------------------------------------------------------------------------
# URL do projeto e chave pública (anon). Podem ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SOMENTE SERVIDOR — NUNCA use o prefixo NEXT_PUBLIC_ nesta variável!
# Necessária apenas para o painel do administrador CRIAR usuários (alunos,
# professores) e redefinir senhas. É usada exclusivamente em Server Actions,
# depois de confirmar no banco que quem chama é administrador.
# Na Vercel: Settings > Environment Variables (não marque como pública).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos QR Codes). Opcional: se vazio, usa o endereço atual.
# Ex.: https://biblioteca-alzira-maia.vercel.app
NEXT_PUBLIC_SITE_URL=
